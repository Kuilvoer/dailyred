+// Fallback static EVs
+const u8 gDailyRedBossEVs[DAILYRED_BOSS_PARTY_SIZE][NUM_STATS] =
+{
+    {  0,   0,   4, 252, 252,   0}, // Pikachu
+    {  4,   0,   0, 252, 252,   0}, // Espeon
+    {144,   0, 188,   0,   0, 176}, // Snorlax
+    {252,   0,  68,   0,   0, 188}, // Venusaur
+    {  0,   0,   4, 252, 252,   0}, // Charizard
+    {252,   0, 252,   0,   0,   4}, // Blastoise
+};
+
+void DailyRed_ApplyBossTeam(struct Pokemon *party, u8 partySize, u32 seed)
+{
+    u8 i, m, stat;
+    u8 iv = MAX_PER_STAT_IVS; // 31
+    u8 friendship = 255;
+    u32 rng = seed ? (seed ^ 0xA5A5A5A5) : Random32();
+
+    for (i = 0; i < partySize && i < DAILYRED_BOSS_PARTY_SIZE; i++)
+    {
+        u8 setIdx;
+        const struct BossMonSet *set;
+
+        rng = ISO_RANDOMIZE1(rng);
+        setIdx = (rng >> 16) % 3;
+        set = &sBossSets[i][setIdx];
+
+        // Apply custom moves with full PP
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            SetMonMoveSlot(&party[i], set->moves[m], m);
+
+        // Apply held item
+        SetMonData(&party[i], MON_DATA_HELD_ITEM, &set->heldItem);
+
+        // Max IVs (31)
+        for (stat = 0; stat < NUM_STATS; stat++)
+            SetMonData(&party[i], MON_DATA_HP_IV + stat, &iv);
+
+        // Tailored EVs for this set
+        for (stat = 0; stat < NUM_STATS; stat++)
+            SetMonData(&party[i], MON_DATA_HP_EV + stat, &set->evs[stat]);
+
+        // Max Friendship (255) for Return power & competitive parity
+        SetMonData(&party[i], MON_DATA_FRIENDSHIP, &friendship);
+
+        // Compute optimal Hidden Power type for the moveset (e.g. HP Ice on Pikachu)
+        {
+            u8 hpType = DailyRed_ComputeBestHiddenPowerType(&party[i]);
+            SetMonData(&party[i], MON_DATA_COOL, &hpType);
+        }
+
+        // Recalculate stats and restore to full HP
+        CalculateMonStats(&party[i]);
+        {
+            u16 maxHp = GetMonData(&party[i], MON_DATA_MAX_HP);
+            SetMonData(&party[i], MON_DATA_HP, &maxHp);
+        }
+    }
+}
diff --git a/src/dailyred_team.c b/src/dailyred_team.c
new file mode 100644
index 0000000..dc31ce7
--- /dev/null
+++ b/src/dailyred_team.c
@@ -0,0 +1,804 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "dailyred.h"
+#include "party_menu.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/region_map_sections.h"
+#include "constants/species.h"
+#include "dailyred_competitive.h"
+
+extern const struct Evolution gEvolutionTable[][EVOS_PER_MON];
+
+// Competitive team generator for Daily Red.
+//
+// Features:
+//   - Fully evolved Pokémon only (evolution filter via gEvolutionTable).
+//   - Role-based competitive movesets & items based on Smogon ADV / Showdown Gen 3 dataset.
+//   - Choice Band rule: strictly damaging moves (no setup/status moves) and guaranteed STAB moves.
+//   - Optimal Hidden Power type tailored to each Pokémon's moveset (with 70 BP while keeping 31 IVs).
+//   - Maximum IVs (31) for all stats.
+//   - Structured EV distribution: 85 EVs per stat (Showdown Random Battles format).
+//   - Maximum Friendship (255) for maximum Return base power (102 BP).
+//   - Correct Max HP synchronization.
+//   - Anti-sweep verification: ensures at least one counter against RED's Charizard.
+
+#define MAX_CANDIDATE_MOVES      128
+#define MAX_TOTAL_EVS            510
+#define MAX_STAT_EVS             252
+#define MIN_TEAM_IV              31   // Maximum IVs (31) hardcoded
+#define MAX_SPECIES_ATTEMPTS     1000
+#define MAX_MON_ATTEMPTS         10
+#define MAX_TEAM_ATTEMPTS        1000
+
+#define MIN_TEAM_BASE_STAT_TOTAL 2700
+#define LEGENDARY_TEAM_ODDS      8
+
+static const u16 sLegendaries[] =
+{
+    SPECIES_ARTICUNO, SPECIES_ZAPDOS, SPECIES_MOLTRES, SPECIES_MEWTWO, SPECIES_MEW,
+    SPECIES_RAIKOU, SPECIES_ENTEI, SPECIES_SUICUNE, SPECIES_LUGIA, SPECIES_HO_OH, SPECIES_CELEBI,
+    SPECIES_REGIROCK, SPECIES_REGICE, SPECIES_REGISTEEL, SPECIES_LATIAS, SPECIES_LATIOS,
+    SPECIES_KYOGRE, SPECIES_GROUDON, SPECIES_RAYQUAZA, SPECIES_JIRACHI, SPECIES_DEOXYS,
+};
+
+static const u16 sFallbackBattleItems[] =
+{
+    ITEM_LEFTOVERS,
+    ITEM_LUM_BERRY,
+    ITEM_SALAC_BERRY,
+    ITEM_WHITE_HERB,
+    ITEM_QUICK_CLAW,
+    ITEM_SCOPE_LENS,
+};
+
+static u16 TeamRandom(u32 *rng)
+{
+    *rng = ISO_RANDOMIZE1(*rng);
+    return *rng >> 16;
+}
+
+static u32 TeamRandom32(u32 *rng)
+{
+    u32 lo = TeamRandom(rng);
+    return lo | ((u32)TeamRandom(rng) << 16);
+}
+
+static const struct CompetitiveSpeciesEntry *GetCompetitiveEntry(u16 species)
+{
+    u16 i;
+    for (i = 0; i < ARRAY_COUNT(sCompetitiveData); i++)
+    {
+        if (sCompetitiveData[i].species == species)
+            return &sCompetitiveData[i];
+    }
+    return NULL;
+}
+
+// Evolution filter: Only fully evolved, non-gimmick species with competitive data
+static bool8 IsEligibleSpecies(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return FALSE;
+    // Unused placeholder slots between Celebi and Treecko
+    if (species >= SPECIES_OLD_UNOWN_B && species <= SPECIES_OLD_UNOWN_Z)
+        return FALSE;
+    // Exclude gimmick/unviable species
+    if (species == SPECIES_UNOWN || species == SPECIES_DITTO || species == SPECIES_SMEARGLE ||
+        species == SPECIES_DELIBIRD || species == SPECIES_LUVDISC)
+        return FALSE;
+    // Evolution filter: exclude base forms and middle evolutions
+    if (gEvolutionTable[species][0].method != 0)
+        return FALSE;
+    // Must have competitive moveset data
+    if (GetCompetitiveEntry(species) == NULL)
+        return FALSE;
+    return TRUE;
+}
+
+static u16 GetBaseStatTotal(u16 species)
+{
+    const struct SpeciesInfo *info = &gSpeciesInfo[species];
+
+    return info->baseHP + info->baseAttack + info->baseDefense
+         + info->baseSpeed + info->baseSpAttack + info->baseSpDefense;
+}
+
+static bool8 IsLegendary(u16 species)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sLegendaries); i++)
+    {
+        if (sLegendaries[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 IsSpeciesTaken(u16 species, const u16 *taken, u8 takenCount)
+{
+    u8 i;
+
+    for (i = 0; i < takenCount; i++)
+    {
+        if (taken[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static u16 PickSpecies(u32 *rng, const u16 *taken, u8 takenCount)
+{
+    u16 species;
+    s32 i;
+
+    for (i = 0; i < MAX_SPECIES_ATTEMPTS; i++)
+    {
+        species = 1 + TeamRandom(rng) % (NUM_SPECIES - 1);
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+
+    for (species = 1; species < NUM_SPECIES; species++)
+    {
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+    return SPECIES_VENUSAUR;
+}
+
+// Anti-sweep check: verify the player's team has at least one effective counter (Water, Rock, or Electric)
+static bool8 HasCharizardCounter(const u16 *species, u8 count)
+{
+    u8 i;
+    for (i = 0; i < count; i++)
+    {
+        u8 t1 = gSpeciesInfo[species[i]].types[0];
+        u8 t2 = gSpeciesInfo[species[i]].types[1];
+        if (t1 == TYPE_WATER || t2 == TYPE_WATER ||
+            t1 == TYPE_ROCK  || t2 == TYPE_ROCK  ||
+            t1 == TYPE_ELECTRIC || t2 == TYPE_ELECTRIC)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static void PickTeamSpecies(u16 *species, u32 *rng)
+{
+    u16 best[PARTY_SIZE];
+    u32 total, bestTotal = 0;
+    s32 attempt;
+    u8 i, first = 0, slot;
+    u16 temp;
+
+    if (TeamRandom(rng) % LEGENDARY_TEAM_ODDS == 0)
+        species[first++] = sLegendaries[TeamRandom(rng) % ARRAY_COUNT(sLegendaries)];
+
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        total = 0;
+        for (i = 0; i < PARTY_SIZE; i++)
+        {
+            if (i >= first)
+                species[i] = PickSpecies(rng, species, i);
+            total += GetBaseStatTotal(species[i]);
+        }
+        if (total >= MIN_TEAM_BASE_STAT_TOTAL)
+            break;
+        if (total > bestTotal)
+        {
+            bestTotal = total;
+            memcpy(best, species, sizeof(best));
+        }
+    }
+    if (attempt == MAX_TEAM_ATTEMPTS)
+        memcpy(species, best, sizeof(best));
+
+    // Anti-sweep verification: ensure team has a counter against RED's Charizard
+    if (!HasCharizardCounter(species, PARTY_SIZE))
+    {
+        for (attempt = 0; attempt < MAX_SPECIES_ATTEMPTS; attempt++)
+        {
+            u16 counterMon = PickSpecies(rng, species, PARTY_SIZE);
+            u8 t1 = gSpeciesInfo[counterMon].types[0];
+            u8 t2 = gSpeciesInfo[counterMon].types[1];
+            if (t1 == TYPE_WATER || t2 == TYPE_WATER ||
+                t1 == TYPE_ROCK  || t2 == TYPE_ROCK  ||
+                t1 == TYPE_ELECTRIC || t2 == TYPE_ELECTRIC)
+            {
+                species[1] = counterMon;
+                break;
+            }
+        }
+    }
+
+    slot = TeamRandom(rng) % PARTY_SIZE;
+    SWAP(species[0], species[slot], temp);
+}
+
+static bool8 IsDamagingMove(u16 move)
+{
+    return move != MOVE_NONE && gBattleMoves[move].power != 0;
+}
+
+static bool8 IsSetupMove(u16 move)
+{
+    switch (move)
+    {
+    case MOVE_SWORDS_DANCE:
+    case MOVE_DRAGON_DANCE:
+    case MOVE_CALM_MIND:
+    case MOVE_BULK_UP:
+    case MOVE_CURSE:
+    case MOVE_BELLY_DRUM:
+    case MOVE_AGILITY:
+    case MOVE_TAIL_GLOW:
+    case MOVE_GROWTH:
+    case MOVE_MEDITATE:
+    case MOVE_HOWL:
+    case MOVE_SHARPEN:
+    case MOVE_IRON_DEFENSE:
+    case MOVE_ACID_ARMOR:
+    case MOVE_BARRIER:
+    case MOVE_AMNESIA:
+    case MOVE_COSMIC_POWER:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static bool8 IsChoiceBandCompatibleMove(u16 move)
+{
+    if (move == MOVE_NONE)
+        return FALSE;
+    if (move == MOVE_TRICK)
+        return TRUE;
+    // Never pick two-turn or conditional moves like Focus Punch, Dream Eater, Solar Beam on Choice Band
+    if (move == MOVE_FOCUS_PUNCH || move == MOVE_DREAM_EATER || move == MOVE_SOLAR_BEAM ||
+        move == MOVE_RAZOR_WIND || move == MOVE_SKULL_BASH || move == MOVE_SKY_ATTACK)
+        return FALSE;
+    return gBattleMoves[move].power != 0;
+}
+
+static bool8 IsNormalBodyMove(u16 move)
+{
+    return (move == MOVE_RETURN || move == MOVE_DOUBLE_EDGE || move == MOVE_BODY_SLAM || move == MOVE_FRUSTRATION);
+}
+
+static void AddCandidateMove(u16 *moves, u8 *count, u16 move)
+{
+    u8 i;
+
+    if (move == MOVE_NONE || move >= MOVES_COUNT || *count >= MAX_CANDIDATE_MOVES)
+        return;
+    for (i = 0; i < *count; i++)
+    {
+        if (moves[i] == move)
+            return;
+    }
+    moves[(*count)++] = move;
+}
+
+static u8 GetLearnableMoves(struct Pokemon *mon, u16 *moves)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    const u16 *learnset = gLevelUpLearnsets[species];
+    u8 count = 0;
+    u8 i;
+
+    for (i = 0; learnset[i] != LEVEL_UP_END; i++)
+        AddCandidateMove(moves, &count, learnset[i] & LEVEL_UP_MOVE_ID);
+
+    for (i = 0; i < NUM_TECHNICAL_MACHINES + NUM_HIDDEN_MACHINES; i++)
+    {
+        if (CanMonLearnTMHM(mon, i))
+            AddCandidateMove(moves, &count, ItemIdToBattleMoveId(ITEM_TM01_FOCUS_PUNCH + i));
+    }
+    return count;
+}
+
+static bool8 IsMoveInArray(u16 move, const u16 *arr, u8 count)
+{
+    u8 i;
+    for (i = 0; i < count; i++)
+    {
+        if (arr[i] == move)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 DoesMoveMatchStabType(u16 move, u8 targetType, const struct CompetitiveRole *role)
+{
+    if (!IsDamagingMove(move))
+        return FALSE;
+    if (move == MOVE_HIDDEN_POWER)
+    {
+        if (role != NULL)
+        {
+            u8 k;
+            for (k = 0; k < role->hpTypesCount; k++)
+            {
+                if (role->hpTypes[k] == targetType)
+                    return TRUE;
+            }
+        }
+        return FALSE;
+    }
+    return gBattleMoves[move].type == targetType;
+}
+
+// Determines the optimal Hidden Power type for a Pokémon based on its species, selected moves, held item, and Showdown role candidates.
+static u8 ChooseBestHiddenPowerType(u16 species, const u16 *moves, u16 heldItem, const u8 *candidateHpTypes, u8 candidateCount)
+{
+    bool8 coveredType[NUMBER_OF_MON_TYPES] = {FALSE};
+    bool8 hasPhysicalSetup = FALSE;
+    bool8 hasSpecialSetup = FALSE;
+    bool8 preferPhysical, preferSpecial;
+    u8 t1 = gSpeciesInfo[species].types[0];
+    u8 t2 = gSpeciesInfo[species].types[1];
+    u8 i;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 m = moves[i];
+        if (m == MOVE_NONE || m == MOVE_HIDDEN_POWER)
+            continue;
+        if (gBattleMoves[m].power != 0 && m != MOVE_SEISMIC_TOSS && m != MOVE_NIGHT_SHADE && m != MOVE_COUNTER && m != MOVE_MIRROR_COAT)
+            coveredType[gBattleMoves[m].type] = TRUE;
+        if (m == MOVE_SWORDS_DANCE || m == MOVE_DRAGON_DANCE || m == MOVE_BULK_UP || m == MOVE_CURSE || m == MOVE_BELLY_DRUM)
+            hasPhysicalSetup = TRUE;
+        if (m == MOVE_CALM_MIND || m == MOVE_TAIL_GLOW || m == MOVE_GROWTH)
+            hasSpecialSetup = TRUE;
+    }
+
+    preferPhysical = (heldItem == ITEM_CHOICE_BAND) || hasPhysicalSetup
+                  || (gSpeciesInfo[species].baseAttack > gSpeciesInfo[species].baseSpAttack + 15 && !hasSpecialSetup);
+    preferSpecial  = hasSpecialSetup
+                  || (gSpeciesInfo[species].baseSpAttack > gSpeciesInfo[species].baseAttack + 15 && !preferPhysical);
+
+    // 1. Check role-specific Showdown Hidden Power candidates first
+    if (candidateHpTypes != NULL && candidateCount > 0)
+    {
+        // Pass 1a: Non-overlapping STAB candidate
+        for (i = 0; i < candidateCount; i++)
+        {
+            u8 t = candidateHpTypes[i];
+            if (t > TYPE_NORMAL && t < NUMBER_OF_MON_TYPES && t != TYPE_MYSTERY && !coveredType[t] && (t == t1 || t == t2))
+                return t;
+        }
+        // Pass 1b: Non-overlapping candidate matching Physical/Special preference
+        for (i = 0; i < candidateCount; i++)
+        {
+            u8 t = candidateHpTypes[i];
+            if (t > TYPE_NORMAL && t < NUMBER_OF_MON_TYPES && t != TYPE_MYSTERY && !coveredType[t])
+            {
+                if ((preferPhysical && IS_TYPE_PHYSICAL(t)) || (preferSpecial && !IS_TYPE_PHYSICAL(t)))
+                    return t;
+            }
+        }
+        // Pass 1c: Any non-overlapping candidate from the role
+        for (i = 0; i < candidateCount; i++)
+        {
+            u8 t = candidateHpTypes[i];
+            if (t > TYPE_NORMAL && t < NUMBER_OF_MON_TYPES && t != TYPE_MYSTERY && !coveredType[t])
+                return t;
+        }
+    }
+
+    // 2. Check other Showdown roles for this species if role candidates weren't found or overlapped
+    {
+        const struct CompetitiveSpeciesEntry *comp = GetCompetitiveEntry(species);
+        if (comp != NULL)
+        {
+            u8 r, k;
+            for (r = 0; r < comp->rolesCount; r++)
+            {
+                const struct CompetitiveRole *role = &comp->roles[r];
+                for (k = 0; k < role->hpTypesCount; k++)
+                {
+                    u8 t = role->hpTypes[k];
+                    if (t > TYPE_NORMAL && t < NUMBER_OF_MON_TYPES && t != TYPE_MYSTERY && !coveredType[t])
+                        return t;
+                }
+            }
+        }
+    }
+
+    // 3. Smart moveset synergy fallback based on covered types and stats
+    if (preferPhysical)
+    {
+        static const u8 sPhysCoverageOrder[] = {
+            TYPE_FIGHTING, TYPE_GROUND, TYPE_ROCK, TYPE_GHOST, TYPE_FLYING, TYPE_BUG, TYPE_STEEL, TYPE_POISON
+        };
+        if (t1 != TYPE_NORMAL && IS_TYPE_PHYSICAL(t1) && !coveredType[t1])
+            return t1;
+        if (t2 != TYPE_NORMAL && IS_TYPE_PHYSICAL(t2) && !coveredType[t2])
+            return t2;
+        for (i = 0; i < ARRAY_COUNT(sPhysCoverageOrder); i++)
+        {
+            u8 t = sPhysCoverageOrder[i];
+            if (!coveredType[t])
+                return t;
+        }
+    }
+    else
+    {
+        // Complementary special coverage based on primary attack types present
+        if (coveredType[TYPE_ELECTRIC] || t1 == TYPE_ELECTRIC || t2 == TYPE_ELECTRIC)
+        {
+            if (!coveredType[TYPE_ICE])   return TYPE_ICE;
+            if (!coveredType[TYPE_GRASS]) return TYPE_GRASS;
+            if (!coveredType[TYPE_FIRE])  return TYPE_FIRE;
+        }
+        if (coveredType[TYPE_FIRE] || t1 == TYPE_FIRE || t2 == TYPE_FIRE)
+        {
+            if (!coveredType[TYPE_GRASS])    return TYPE_GRASS;
+            if (!coveredType[TYPE_ICE])      return TYPE_ICE;
+            if (!coveredType[TYPE_ELECTRIC]) return TYPE_ELECTRIC;
+        }
+        if (coveredType[TYPE_WATER] || t1 == TYPE_WATER || t2 == TYPE_WATER)
+        {
+            if (!coveredType[TYPE_ELECTRIC]) return TYPE_ELECTRIC;
+            if (!coveredType[TYPE_GRASS])    return TYPE_GRASS;
+            if (!coveredType[TYPE_ICE])      return TYPE_ICE;
+        }
+        if (coveredType[TYPE_GRASS] || t1 == TYPE_GRASS || t2 == TYPE_GRASS)
+        {
+            if (!coveredType[TYPE_FIRE]) return TYPE_FIRE;
+            if (!coveredType[TYPE_ICE])  return TYPE_ICE;
+            if (!coveredType[TYPE_ROCK]) return TYPE_ROCK;
+        }
+        if (coveredType[TYPE_PSYCHIC] || t1 == TYPE_PSYCHIC || t2 == TYPE_PSYCHIC)
+        {
+            if (!coveredType[TYPE_FIRE])     return TYPE_FIRE;
+            if (!coveredType[TYPE_FIGHTING]) return TYPE_FIGHTING;
+            if (!coveredType[TYPE_DARK])     return TYPE_DARK;
+        }
+        {
+            static const u8 sSpecCoverageOrder[] = {
+                TYPE_ICE, TYPE_GRASS, TYPE_FIRE, TYPE_ELECTRIC, TYPE_WATER, TYPE_PSYCHIC, TYPE_DARK, TYPE_DRAGON
+            };
+            for (i = 0; i < ARRAY_COUNT(sSpecCoverageOrder); i++)
+            {
+                u8 t = sSpecCoverageOrder[i];
+                if (!coveredType[t])
+                    return t;
+            }
+        }
+    }
+
+    return TYPE_ICE;
+}
+
+u8 DailyRed_ComputeBestHiddenPowerType(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u16 heldItem = GetMonData(mon, MON_DATA_HELD_ITEM);
+    u16 moves[MAX_MON_MOVES];
+    u8 i;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        moves[i] = GetMonData(mon, MON_DATA_MOVE1 + i);
+
+    return ChooseBestHiddenPowerType(species, moves, heldItem, NULL, 0);
+}
+
+u8 DailyRed_GetHiddenPowerType(struct Pokemon *mon)
+{
+    u8 hpType = GetMonData(mon, MON_DATA_COOL);
+    if (hpType > TYPE_NORMAL && hpType < NUMBER_OF_MON_TYPES && hpType != TYPE_MYSTERY)
+        return hpType;
+    return DailyRed_ComputeBestHiddenPowerType(mon);
+}
+
+u8 DailyRed_GetBattlerHiddenPowerType(u8 battler)
+{
+    struct Pokemon *party = ((gBattlerPositions[battler] & BIT_SIDE) == B_SIDE_OPPONENT) ? gEnemyParty : gPlayerParty;
+    struct Pokemon *mon = &party[gBattlerPartyIndexes[battler]];
+    return DailyRed_GetHiddenPowerType(mon);
+}
