+// Assigns role-based competitive moves, held item, and optimal Hidden Power type
+static void AssignCompetitiveRoleMovesAndItem(struct Pokemon *mon, u32 *rng)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    const struct CompetitiveSpeciesEntry *comp = GetCompetitiveEntry(species);
+    const struct CompetitiveRole *role = NULL;
+    u16 candidates[MAX_CANDIDATE_MOVES];
+    u16 selected[MAX_MON_MOVES] = {MOVE_NONE, MOVE_NONE, MOVE_NONE, MOVE_NONE};
+    u8 count = 0, selectedCount = 0, targetMoves, i, j;
+    u16 item = ITEM_LEFTOVERS;
+    u16 temp;
+    u8 t1 = gSpeciesInfo[species].types[0];
+    u8 t2 = gSpeciesInfo[species].types[1];
+    u8 hpType;
+
+    if (comp != NULL && comp->rolesCount > 0)
+    {
+        role = &comp->roles[TeamRandom(rng) % comp->rolesCount];
+        if (role->itemsCount > 0)
+            item = role->items[TeamRandom(rng) % role->itemsCount];
+
+        for (i = 0; i < role->movesCount && count < MAX_CANDIDATE_MOVES; i++)
+        {
+            u16 m = role->moves[i];
+            if (item == ITEM_CHOICE_BAND && !IsChoiceBandCompatibleMove(m))
+                continue;
+            AddCandidateMove(candidates, &count, m);
+        }
+
+        // If Choice Band filtering left fewer than 4 moves, supplement from other roles' compatible moves
+        if (item == ITEM_CHOICE_BAND && count < MAX_MON_MOVES)
+        {
+            u8 r;
+            for (r = 0; r < comp->rolesCount; r++)
+            {
+                for (i = 0; i < comp->roles[r].movesCount && count < MAX_CANDIDATE_MOVES; i++)
+                {
+                    u16 m = comp->roles[r].moves[i];
+                    if (IsChoiceBandCompatibleMove(m))
+                        AddCandidateMove(candidates, &count, m);
+                }
+            }
+        }
+    }
+
+    if (count == 0)
+    {
+        count = GetLearnableMoves(mon, candidates);
+        item = sFallbackBattleItems[TeamRandom(rng) % ARRAY_COUNT(sFallbackBattleItems)];
+    }
+
+    // Shuffle candidates uniformly
+    for (i = 0; i < count; i++)
+    {
+        j = i + TeamRandom(rng) % (count - i);
+        SWAP(candidates[i], candidates[j], temp);
+    }
+
+    targetMoves = min(count, MAX_MON_MOVES);
+
+    // Step 1: Guarantee STAB damaging move(s)
+    // Primary STAB (type1)
+    for (i = 0; i < count && selectedCount < targetMoves; i++)
+    {
+        if (DoesMoveMatchStabType(candidates[i], t1, role))
+        {
+            selected[selectedCount++] = candidates[i];
+            break;
+        }
+    }
+    // Secondary STAB (type2) — always include on Choice Band or if primary STAB wasn't found
+    if (t2 != t1 && (item == ITEM_CHOICE_BAND || selectedCount == 0))
+    {
+        for (i = 0; i < count && selectedCount < targetMoves; i++)
+        {
+            if (!IsMoveInArray(candidates[i], selected, selectedCount)
+                && DoesMoveMatchStabType(candidates[i], t2, role))
+            {
+                selected[selectedCount++] = candidates[i];
+                break;
+            }
+        }
+    }
+
+    // Step 2: For non-Choice Band sets, if the role has a setup move, include at most 1 setup move
+    if (item != ITEM_CHOICE_BAND)
+    {
+        for (i = 0; i < count && selectedCount < targetMoves; i++)
+        {
+            if (!IsMoveInArray(candidates[i], selected, selectedCount) && IsSetupMove(candidates[i]))
+            {
+                selected[selectedCount++] = candidates[i];
+                break;
+            }
+        }
+    }
+
+    // Step 3: Fill remaining slots avoiding duplicate Normal body moves, extra setup moves, or orphan Sleep Talk
+    for (i = 0; i < count && selectedCount < targetMoves; i++)
+    {
+        u16 m = candidates[i];
+        bool8 hasNormalBody = FALSE;
+        bool8 hasSetup = FALSE;
+        u8 k;
+
+        if (IsMoveInArray(m, selected, selectedCount))
+            continue;
+        if (item == ITEM_CHOICE_BAND && !IsChoiceBandCompatibleMove(m))
+            continue;
+
+        for (k = 0; k < selectedCount; k++)
+        {
+            if (IsNormalBodyMove(selected[k]))
+                hasNormalBody = TRUE;
+            if (IsSetupMove(selected[k]))
+                hasSetup = TRUE;
+        }
+
+        if (IsNormalBodyMove(m) && hasNormalBody)
+            continue;
+        if (IsSetupMove(m) && hasSetup)
+            continue;
+        if (m == MOVE_SLEEP_TALK && !IsMoveInArray(MOVE_REST, candidates, count))
+            continue;
+
+        selected[selectedCount++] = m;
+    }
+
+    // Fallback pass if < targetMoves due to Normal-move deduplication
+    for (i = 0; i < count && selectedCount < targetMoves; i++)
+    {
+        u16 m = candidates[i];
+        if (IsMoveInArray(m, selected, selectedCount))
+            continue;
+        if (item == ITEM_CHOICE_BAND && !IsChoiceBandCompatibleMove(m))
+            continue;
+        selected[selectedCount++] = m;
+    }
+
+    // Step 4: Ensure Sleep Talk is never present without Rest
+    if (IsMoveInArray(MOVE_SLEEP_TALK, selected, selectedCount) && !IsMoveInArray(MOVE_REST, selected, selectedCount))
+    {
+        if (IsMoveInArray(MOVE_REST, candidates, count) && selectedCount >= 2)
+        {
+            // Put Rest into the last slot (unless that slot is Sleep Talk itself)
+            u8 replaceIdx = (selected[selectedCount - 1] == MOVE_SLEEP_TALK) ? (selectedCount - 2) : (selectedCount - 1);
+            selected[replaceIdx] = MOVE_REST;
+        }
+        else
+        {
+            // Replace Sleep Talk with another move from candidates
+            for (i = 0; i < selectedCount; i++)
+            {
+                if (selected[i] == MOVE_SLEEP_TALK)
+                {
+                    for (j = 0; j < count; j++)
+                    {
+                        if (!IsMoveInArray(candidates[j], selected, selectedCount) && candidates[j] != MOVE_SLEEP_TALK)
+                        {
+                            selected[i] = candidates[j];
+                            break;
+                        }
+                    }
+                    break;
+                }
+            }
+        }
+    }
+
+    // Step 5: Ensure at least 1 damaging move exists
+    for (i = 0; i < selectedCount && !IsDamagingMove(selected[i]); i++)
+        ;
+    if (i == selectedCount)
+    {
+        for (j = 0; j < count; j++)
+        {
+            if (IsDamagingMove(candidates[j]))
+            {
+                selected[0] = candidates[j];
+                break;
+            }
+        }
+    }
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        SetMonMoveSlot(mon, i < selectedCount ? selected[i] : MOVE_NONE, i);
+
+    SetMonData(mon, MON_DATA_HELD_ITEM, &item);
+
+    hpType = ChooseBestHiddenPowerType(species, selected, item, role ? role->hpTypes : NULL, role ? role->hpTypesCount : 0);
+    SetMonData(mon, MON_DATA_COOL, &hpType);
+}
+
+// Structured EV distribution: 85 EVs per stat (Showdown Random Battles: 85 * 6 = 510)
+static void AssignStructuredEVs(struct Pokemon *mon)
+{
+    u8 stat;
+    u8 ev = 85;
+
+    for (stat = 0; stat < NUM_STATS; stat++)
+        SetMonData(mon, MON_DATA_HP_EV + stat, &ev);
+}
+
+static void CreateTeamMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateMon(mon, species, MAX_LEVEL, 0, TRUE, TeamRandom32(rng), OT_ID_PLAYER_ID, 0);
+}
+
+static void FinishTeamMon(struct Pokemon *mon)
+{
+    u8 metLocation = METLOC_FATEFUL_ENCOUNTER;
+    u8 fateful = TRUE;
+    u8 friendship = 255;
+    u8 i, iv;
+    u16 maxHp;
+
+    // Hardcode maximum IVs (31) for all stats
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        iv = MAX_PER_STAT_IVS; // 31
+        SetMonData(mon, MON_DATA_HP_IV + i, &iv);
+    }
+    AssignStructuredEVs(mon);
+
+    SetMonData(mon, MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fateful);
+    SetMonData(mon, MON_DATA_MET_LOCATION, &metLocation);
+    // Max friendship (255) ensures Return reaches full 102 base power
+    SetMonData(mon, MON_DATA_FRIENDSHIP, &friendship);
+
+    CalculateMonStats(mon);
+    // Ensure current HP is synchronized with newly calculated max HP
+    maxHp = GetMonData(mon, MON_DATA_MAX_HP);
+    SetMonData(mon, MON_DATA_HP, &maxHp);
+}
+
+static void CreateRandomMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateTeamMon(mon, species, rng);
+    AssignCompetitiveRoleMovesAndItem(mon, rng);
+    FinishTeamMon(mon);
+}
+
+static bool8 IsValidTeamMon(struct Pokemon *mon)
+{
+    u16 moves[MAX_MON_MOVES];
+    u8 i, j;
+
+    if (!IsEligibleSpecies(GetMonData(mon, MON_DATA_SPECIES)))
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_LEVEL) != MAX_LEVEL)
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_MAX_HP) == 0 || GetMonData(mon, MON_DATA_HP) != GetMonData(mon, MON_DATA_MAX_HP))
+        return FALSE;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        moves[i] = GetMonData(mon, MON_DATA_MOVE1 + i);
+    if (moves[0] == MOVE_NONE || GetMonData(mon, MON_DATA_HELD_ITEM) == ITEM_NONE)
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (moves[i] == MOVE_NONE)
+            continue;
+        if (GetMonData(mon, MON_DATA_PP1 + i) == 0)
+            return FALSE;
+        for (j = i + 1; j < MAX_MON_MOVES; j++)
+        {
+            if (moves[i] == moves[j])
+                return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rngState)
+{
+    u16 species[PARTY_SIZE];
+    u8 i, attempt;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        ZeroMonData(&party[i]);
+
+    PickTeamSpecies(species, rngState);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        for (attempt = 0; attempt < MAX_MON_ATTEMPTS; attempt++)
+        {
+            CreateRandomMon(&party[i], species[i], rngState);
+            if (IsValidTeamMon(&party[i]))
+                break;
+        }
+
+        // Never revert to vanilla default moves: if all attempts fail, re-generate with CreateRandomMon
+        if (attempt == MAX_MON_ATTEMPTS)
+        {
+            CreateRandomMon(&party[i], species[i], rngState);
+        }
+    }
+}
