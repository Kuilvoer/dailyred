@@ -0,0 +1,49 @@
+#ifndef GUARD_DAILYRED_H
+#define GUARD_DAILYRED_H
+
+// Daily Red: a one-battle challenge mode built on FireRed.
+//
+// The player boots straight onto a snowy mountain peak (MAP_DAILY_RED_SUMMIT)
+// as LEAF with six random level 100 Pokemon, climbs to RED and talks to him
+// to start a normal
+// FireRed trainer battle. Win or lose, a new team is generated and the next
+// run starts in the same room.
+//
+// Every vanilla file touched for this mode has a "Daily Red:" comment at the
+// change, so `grep -rn "Daily Red" src include data` lists them all.
+
+#include "global.h"
+#include "battle.h"
+#include "constants/dailyred.h"
+#include "constants/pokemon.h"
+
+#define DAILYRED_BOSS_PARTY_SIZE 6
+
+
+// The boss team (species, IVs, items, moves) and its EV spreads.
+// Edit src/dailyred_boss.c to change it.
+extern const struct TrainerMonItemCustomMoves gDailyRedBossParty[DAILYRED_BOSS_PARTY_SIZE];
+extern const u8 gDailyRedBossEVs[DAILYRED_BOSS_PARTY_SIZE][NUM_STATS];
+
+// src/dailyred.c
+bool8 DailyRed_HasInjectedSeed(void);
+void CB2_DailyRed_StartFromCopyright(void);
+void CB2_DailyRed_StartFromTitle(void);
+void DailyRed_InitNewGame(void);
+void DailyRed_StartNextRun(void);
+void DailyRed_OnBattleStart(void);
+void DailyRed_OnBattleEnd(void);
+void DailyRed_OnDailyGameOver(void);
+u16 DailyRed_IsDailyGame(void);
+void DailyRed_ApplyBossEVs(struct Pokemon *party, u8 partySize);
+
+// src/dailyred_boss.c
+void DailyRed_ApplyBossTeam(struct Pokemon *party, u8 partySize, u32 seed);
+
+// src/dailyred_team.c
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rngState);
+u8 DailyRed_GetHiddenPowerType(struct Pokemon *mon);
+u8 DailyRed_GetBattlerHiddenPowerType(u8 battler);
+u8 DailyRed_ComputeBestHiddenPowerType(struct Pokemon *mon);
+
+#endif // GUARD_DAILYRED_H
